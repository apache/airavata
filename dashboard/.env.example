# Only needed for `npm run dev`, where the dashboard runs on :3000 and the API on
# :9095. The built dashboard is served by the API server itself and calls it on the
# same origin, so leave this unset for `npm run build`.
NEXT_PUBLIC_AIRAVATA_API_URL=http://localhost:9095

# Branding, applied when the dashboard is built. Both are optional; with neither set the
# sidebar shows the Airavata mark and name. A relative logo URL is a file under public/
# (e.g. logo.svg -> /dashboard/logo.svg). To rebrand an existing build without rebuilding,
# edit out/branding.json instead: {"name": "My Portal", "logoUrl": "logo.svg"}.
# NEXT_PUBLIC_AIRAVATA_BRAND_NAME=My Portal
# NEXT_PUBLIC_AIRAVATA_BRAND_LOGO_URL=logo.svg
