set -e

STATE_DIR="/var/run/mock-slurm"
JOBS_DIR="$STATE_DIR/jobs"

if [ $# -eq 0 ]; then
    echo "scancel: error: no job id provided" >&2
    exit 1
fi

JOB_ID="$1"
meta="$JOBS_DIR/$JOB_ID/metadata"

if [ ! -f "$meta" ]; then
    echo "scancel: error: job $JOB_ID not found" >&2
    exit 1
fi

jpid=$(grep "^PID=" "$meta" | cut -d= -f2)
if [ -n "$jpid" ] && kill -0 "$jpid" 2>/dev/null; then
    kill -TERM "$jpid" 2>/dev/null || true
    sleep 0.1
    kill -KILL "$jpid" 2>/dev/null || true
fi

echo "STATUS=CANCELLED" >> "$meta"
echo "END_TIME=$(date +%s)" >> "$meta"
exit 0
