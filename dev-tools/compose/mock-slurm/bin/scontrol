set -e

cmd=""
subcmd=""
oneline=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|--oneliner)
            oneline=true
            shift
            ;;
        show)
            cmd="show"
            shift
            ;;
        partition|partitions)
            subcmd="partition"
            shift
            ;;
        ping)
            cmd="ping"
            shift
            ;;
        *)
            shift
            ;;
    esac
done

if [ "$cmd" = "ping" ]; then
    echo "Slurmctld(primary) at mock-slurm is UP"
    exit 0
fi

if [ "$cmd" = "show" ] && [ "$subcmd" = "partition" ]; then
    if [ "$oneline" = true ]; then
        echo "PartitionName=debug TotalNodes=1 TotalCPUs=4 MaxNodes=1 MaxTime=01:00:00 DefaultTime=00:30:00 MaxMemPerNode=4096 Nodes=mock-node01 Default=YES"
        echo "PartitionName=compute TotalNodes=4 TotalCPUs=16 MaxNodes=4 MaxTime=24:00:00 DefaultTime=01:00:00 MaxMemPerNode=16384 Nodes=mock-node[02-05] Default=NO"
    else
        echo "PartitionName=debug"
        echo "   TotalNodes=1 TotalCPUs=4 MaxNodes=1 MaxTime=01:00:00 DefaultTime=00:30:00 MaxMemPerNode=4096"
        echo "   Nodes=mock-node01 Default=YES"
        echo ""
        echo "PartitionName=compute"
        echo "   TotalNodes=4 TotalCPUs=16 MaxNodes=4 MaxTime=24:00:00 DefaultTime=01:00:00 MaxMemPerNode=16384"
        echo "   Nodes=mock-node[02-05] Default=NO"
    fi
    exit 0
fi

echo "scontrol: command not supported in mock" >&2
exit 0
