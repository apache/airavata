set -e

custom_format=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|--format)
            custom_format="$2"
            shift 2
            ;;
        --format=*)
            custom_format="${1#*=}"
            shift
            ;;
        *)
            shift
            ;;
    esac
done

# If custom format requested (like %R|%c|%m|%G for Airavata partition discovery)
if [[ "$custom_format" == *"%R|%c|%m|%G"* ]]; then
    echo "debug|4|4096|null"
    echo "compute|4|16384|gpu:1"
    exit 0
fi

echo "PARTITION AVAIL  TIMELIMIT  NODES  STATE NODELIST"
echo "debug*       up   01:00:00      1   idle mock-node01"
echo "compute      up 1-00:00:00      4   idle mock-node[02-05]"
exit 0
